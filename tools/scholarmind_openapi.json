{
  "openapi": "3.1.0",
  "info": {
    "title": "ScholarMind Tool Service",
    "description": "Academic paper search and NLP keyphrase extraction tools for the ScholarMind multi-agent system.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://host.docker.internal:8900" }
  ],
  "paths": {
    "/search_papers": {
      "get": {
        "summary": "Search academic papers on arXiv",
        "description": "Searches the public arXiv API for academic papers matching a query and returns structured results including title, authors, abstract, publication date, arXiv ID, and PDF URL.",
        "operationId": "search_papers",
        "parameters": [
          { "name": "query", "in": "query", "required": true, "description": "The research topic or search keywords.", "schema": { "type": "string" } },
          { "name": "max_results", "in": "query", "required": false, "description": "Number of papers to return (1-25). Default is 8.", "schema": { "type": "integer", "default": 8 } },
          { "name": "sort_by", "in": "query", "required": false, "description": "Sort order: 'relevance' or 'lastUpdatedDate'.", "schema": { "type": "string", "default": "relevance" } }
        ],
        "responses": {
          "200": { "description": "A list of matching academic papers.", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/extract_keyphrases": {
      "post": {
        "summary": "Extract keyphrases from text",
        "description": "Runs a hand-written NLP keyphrase extraction routine over the supplied text and returns the most salient phrases.",
        "operationId": "extract_keyphrases",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string", "description": "The raw text to analyse." },
                  "top_k": { "type": "integer", "description": "How many keyphrases to return.", "default": 10 }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "The extracted keyphrases.", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    }
  },
  "components": { "schemas": {} }
}
